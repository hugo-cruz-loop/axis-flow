# --- Go ---
# Binaries for programs and plugins
/bin/
**/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Build directories
pkg/
**/pkg/

# Dependency directories
vendor/
**/vendor/

# Go workspace file
go.work

# Go coverage
coverage.out
*.cover
*.coverprofile

# Generated files
*.exe
*.log
*.tmp
*.temp
*.cache

# --- Node / React ---
node_modules/
**/node_modules/

# Build output
dist/
build/
coverage/

# Environment variables
.env
.env.*

# --- Secrets (operator-managed, never committed) ---
# Private keys (TLS, JWT signing, M2M HMAC, etc.)
*.key
*.pem
*.p12
# Firebase / Google Cloud service-account JSON. The
# FIREBASE_CREDENTIALS_JSON env var carries the content
# at runtime; the file form must never enter the repo.
firebase*.json
*firebase*.json
gcp-*.json
gcp-*-credentials.json
# Operator-managed secret directories. The Scheduler
# compose (axis-flow-back/deploy/scheduler.docker-compose.yml)
# references ./secrets/firebase.creds.env and
# ./secrets/scheduler_m2m.env from the deploy/ directory.
secrets/
**/secrets/
deploy/secrets/
**/deploy/secrets/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# IDE / editor files
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# --- Documentation ---
/docs/
**/docs/

# Misc
*.local
*.tmp
*.temp

# OS generated files
Thumbs.db
Desktop.ini

.agent/
.agents/
.claude/
.atl/